# Epistrel Engine settings. Every variable is EPISTREL_<NAME>; the service refuses to start
# on a missing or malformed required setting and names it. Copy to .env (gitignored) or
# pass with `uv run --env-file .env epistrel serve`.

# SQLAlchemy URL of the Postgres database; must use the psycopg driver.
EPISTREL_DATABASE_URL=<required>   # e.g. postgresql+psycopg://epistrel:epistrel-dev@localhost:5432/epistrel

# Logging level: CRITICAL, ERROR, WARNING, INFO, DEBUG.
EPISTREL_LOG_LEVEL=INFO

# Bind address and port for `epistrel serve`.
EPISTREL_HOST=0.0.0.0
EPISTREL_PORT=8000

# Development mode: forces DEBUG logging and enables auto-reload. Never on in production.
EPISTREL_DEBUG=false

# Service credentials (FR-AUTH-1): comma-separated, each at least 32 characters; every REST call
# except GET /health, /metrics, /openapi.json, /docs and /redoc sends one as
# `Authorization: Bearer <credential>`. Several allow rotation; all are equivalent.
EPISTREL_SERVICE_CREDENTIALS=<required>   # e.g. the output of `openssl rand -hex 32`

# Accept REST calls without a credential. Development only: refused unless EPISTREL_DEBUG is on.
EPISTREL_AUTH_DISABLED=false

# Key that encrypts stored model API keys (model_config): URL-safe base64 of 32 random bytes, e.g.
# `python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`.
# Required once any model API key is stored (the server refuses to start without it, exit 78).
# EPISTREL_CONFIG_KEY=

# Model adapter for every purpose: `openai` (OpenAI-compatible endpoints configured per purpose
# under /admin/model-config) or `stub` (deterministic test answers; no endpoint or key needed).
EPISTREL_MODEL_ADAPTER=openai

# Seconds the stub adapter waits before answering (latency and load tests only).
EPISTREL_STUB_LATENCY_S=0

# A projection rebuild of a story with more events than this runs as a background job;
# smaller stories rebuild synchronously in the request.
EPISTREL_REBUILD_ASYNC_THRESHOLD=10000

# Process mode (`epistrel serve --mode` overrides it): `all` serves the API and runs the worker
# loops in one process (the default; `docker compose up` needs nothing else), `api` serves the API
# only, `worker` runs the worker loops and serves only /health.
EPISTREL_MODE=all

# Background workers (`all` and `worker` modes): seconds between polls for due jobs (notifications only
# shorten the wait), the job lease in seconds (renewed every third of it), failed attempts before
# a job is `failed`, whether to LISTEN for job notifications, and how many worker loops run.
EPISTREL_WORKER_POLL_INTERVAL=5
EPISTREL_JOB_LEASE_SECONDS=60
EPISTREL_JOB_MAX_ATTEMPTS=5
EPISTREL_WORKER_LISTEN_ENABLED=true
EPISTREL_WORKER_CONCURRENCY=2

# Where the local blob store keeps media bytes (#105): <root>/<sha256[:2]>/<sha256>, uploads staged
# under <root>/tmp. Created at start-up; an unwritable root refuses the start (exit 78). The image
# sets /var/lib/epistrel/media (compose mounts the `media` volume there).
EPISTREL_MEDIA_ROOT=var/media

# Telemetry (#74): logs are JSON on stdout with identifiers and counts only; GET /metrics serves
# Prometheus text. OTLP/HTTP traces go to this collector when set (e.g. http://collector:4318;
# OTEL_EXPORTER_OTLP_* variables tune the exporter); unset leaves tracing off.
# EPISTREL_OTLP_ENDPOINT=
# Operator-only content debug logging: log lines carry story content. Refused unless
# EPISTREL_DEBUG is on, switches itself off after 24 hours; keep such logs at most 7 days.
EPISTREL_CONTENT_DEBUG_LOGGING=false

# Test tooling only (never a setting): point integration tests at a running PostgreSQL 16 + pgvector
# server instead of starting a container. The role needs CREATEDB (migration tests use scratch DBs).
# EPISTREL_TEST_DATABASE_URL=postgresql+psycopg://test:test@localhost:5432/test
