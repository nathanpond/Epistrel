# Epistrel Engine settings. Every variable is EPISTREL_<NAME>; the service refuses to start
# on a missing or malformed required setting and names it. Copy to .env (gitignored) or
# pass with `uv run --env-file .env epistrel serve`.

# SQLAlchemy URL of the Postgres database; must use the psycopg driver.
EPISTREL_DATABASE_URL=<required>   # e.g. postgresql+psycopg://epistrel:epistrel-dev@localhost:5432/epistrel

# Logging level: CRITICAL, ERROR, WARNING, INFO, DEBUG.
EPISTREL_LOG_LEVEL=INFO

# Bind address and port for `epistrel serve`.
EPISTREL_HOST=0.0.0.0
EPISTREL_PORT=8000

# Development mode: forces DEBUG logging and enables auto-reload. Never on in production.
EPISTREL_DEBUG=false

# Test tooling only (never a setting): point integration tests at a running PostgreSQL 16 + pgvector
# server instead of starting a container. The role needs CREATEDB (migration tests use scratch DBs).
# EPISTREL_TEST_DATABASE_URL=postgresql+psycopg://test:test@localhost:5432/test
